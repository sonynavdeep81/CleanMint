#!/usr/bin/env bash
# cleanmint-helper — CleanMint Privileged Helper
# Installed to /usr/local/lib/cleanmint/cleanmint-helper
# Called exclusively via pkexec — runs as root with a single auth prompt.
# All CleanMint privileged operations go through this single entry point.
#
# Usage: pkexec /usr/local/lib/cleanmint/cleanmint-helper OPERATION [ARGS...]

set -e

OPERATION="${1:-}"
shift || true

case "$OPERATION" in
    journal-vacuum)
        exec /usr/bin/journalctl --vacuum-size=50M --vacuum-time=7d
        ;;
    apt-clean)
        exec /usr/bin/apt-get clean
        ;;
    apt-update)
        exec /usr/bin/apt-get update
        ;;
    apt-upgrade)
        exec /usr/bin/apt-get upgrade -y \
            -o "Dpkg::Options::=--force-confdef" \
            -o "Dpkg::Options::=--force-confold"
        ;;
    apt-upgrade-pkgs)
        # Args: <pkg1> <pkg2> ...
        [[ $# -ge 1 ]] || { echo "apt-upgrade-pkgs requires package names" >&2; exit 1; }
        exec /usr/bin/apt-get install --only-upgrade -y \
            -o "Dpkg::Options::=--force-confdef" \
            -o "Dpkg::Options::=--force-confold" "$@"
        ;;
    snap-remove)
        # Args: <name> <revision>
        [[ $# -ge 2 ]] || { echo "snap-remove requires <name> <revision>" >&2; exit 1; }
        exec /usr/bin/snap remove --revision "$2" "$1"
        ;;
    snap-refresh-all)
        exec /usr/bin/snap refresh --ignore-running
        ;;
    snap-refresh-pkg)
        # Args: <name>
        [[ $# -ge 1 ]] || { echo "snap-refresh-pkg requires <name>" >&2; exit 1; }
        exec /usr/bin/snap refresh --ignore-running "$1"
        ;;
    systemctl-restart)
        # Args: <service>
        [[ $# -ge 1 ]] || { echo "systemctl-restart requires <service>" >&2; exit 1; }
        exec /usr/bin/systemctl restart "$1"
        ;;
    apt-remove)
        # Args: <package>
        [[ $# -ge 1 ]] || { echo "apt-remove requires <package>" >&2; exit 1; }
        exec /usr/bin/apt-get remove -y "$1"
        ;;
    snap-uninstall)
        # Args: <name>  (removes all revisions)
        [[ $# -ge 1 ]] || { echo "snap-uninstall requires <name>" >&2; exit 1; }
        exec /usr/bin/snap remove "$1"
        ;;
    flatpak-uninstall)
        # Args: <app-id>
        [[ $# -ge 1 ]] || { echo "flatpak-uninstall requires <app-id>" >&2; exit 1; }
        exec /usr/bin/flatpak uninstall -y "$1"
        ;;
    obs-lock|obs-unlock)
        # Toggle the immutable (+i) attribute on the OBS-switcher files that
        # must never be modified or deleted. Paths are derived from the
        # calling user's home — this op can only ever touch this fixed list.
        home="$(getent passwd "${PKEXEC_UID:-0}" | cut -d: -f6)"
        [[ -n "$home" && -d "$home" ]] || {
            echo "obs-lock: cannot resolve caller home directory" >&2
            exit 1
        }
        flag="+i"
        [[ "$OPERATION" == "obs-unlock" ]] && flag="-i"
        for rel in ".local/bin/obs-scene" \
                   ".config/obs-hotkeys/password" \
                   ".config/obs-hotkeys"; do
            target="$home/$rel"
            if [[ -e "$target" ]]; then
                /usr/bin/chattr "$flag" "$target" 2>/dev/null || true
            fi
        done
        exit 0
        ;;
    obs-v4l2)
        # Load the v4l2loopback module as /dev/video42 ("CleanMint Tablet") so
        # scrcpy can pipe the tablet screen into OBS as a plain capture device
        # (no Wayland portal picker). Also makes it persistent across reboots.
        nr=42
        label="CleanMint Tablet"
        if [[ ! -e /dev/video${nr} ]]; then
            /sbin/modprobe v4l2loopback "video_nr=${nr}" \
                "card_label=${label}" exclusive_caps=1 || {
                echo "obs-v4l2: modprobe v4l2loopback failed (is it installed?)" >&2
                exit 1
            }
        fi
        # Permissions: uaccess usually grants the active user, but ensure the
        # video group can use it too.
        if [[ -e /dev/video${nr} ]]; then
            /bin/chgrp video "/dev/video${nr}" 2>/dev/null || true
            /bin/chmod 660 "/dev/video${nr}" 2>/dev/null || true
        fi
        # Persist across reboots.
        printf 'options v4l2loopback video_nr=%s card_label="%s" exclusive_caps=1\n' \
            "${nr}" "${label}" > /etc/modprobe.d/cleanmint-v4l2.conf
        echo v4l2loopback > /etc/modules-load.d/cleanmint-v4l2.conf
        printf 'SUBSYSTEM=="video4linux", ATTR{name}=="%s", TAG+="uaccess", MODE="0660", GROUP="video"\n' \
            "${label}" > /etc/udev/rules.d/99-cleanmint-v4l2.rules
        exit 0
        ;;
    *)
        echo "cleanmint-helper: unknown operation '${OPERATION}'" >&2
        echo "Valid: journal-vacuum, apt-clean, apt-update, apt-upgrade, apt-upgrade-pkgs," >&2
        echo "       snap-remove, snap-uninstall, apt-remove," >&2
        echo "       flatpak-uninstall, systemctl-restart, obs-lock, obs-unlock," >&2
        echo "       obs-v4l2" >&2
        exit 1
        ;;
esac
